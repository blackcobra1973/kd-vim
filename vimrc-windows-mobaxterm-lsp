"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" => Vim Environment
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" Environment {
  " This variant targets terminal Vim running inside MobaXterm's
  " Cygwin/Unix-like environment on Windows. It intentionally does not
  " configure Windows gVim or any X11 GUI.
  function! MOBAXTERM() abort
    if exists('g:kd_force_mobaxterm') && g:kd_force_mobaxterm
      return 1
    endif

    " MobaXterm normally exposes Windows drives below /drives and provides
    " /bin/bash. win32unix covers Vim builds that explicitly identify the
    " Cygwin-style environment.
    return executable('/bin/bash')
          \ && (isdirectory('/drives') || has('win32unix'))
  endfunction

  if !MOBAXTERM()
    echoerr 'This Vimrc requires MobaXterm terminal Vim.'
    finish
  endif

  let g:kd_config_version = '1.5.2'
  let g:kd_package_version = '2.7.2'

  " Vim 1.5.2 completion/LSP baseline:
  "   - yegappan/lsp requires Vim 9.0 or newer.
  "   - The LSP client is pure Vim9 script: Deno/denops are no longer required.
  "   - Language servers are installed independently by tools/lsp/lsp-manager-mobaxterm.sh.
  function! s:KDHasSupportedVimForLsp() abort
    return has('patch-9.0.0000') && has('job') && has('channel')
  endfunction

  if !exists('g:kd_lsp_home')
    let g:kd_lsp_home = expand('~/.local/share/vim-lsp')
  else
    let g:kd_lsp_home = expand(g:kd_lsp_home)
  endif
  let g:kd_lsp_bin = g:kd_lsp_home . '/bin'

  " Make the manager's stable wrappers available to child processes and LSPs.
  " This is also useful for servers such as helm_ls which may invoke another
  " managed server (for example yaml-language-server).
  if isdirectory(g:kd_lsp_bin)
    let s:kd_path_sep = (has('win32') || has('win64')) && !has('win32unix') ? ';' : ':'
    if index(split($PATH, s:kd_path_sep), g:kd_lsp_bin) < 0
      let $PATH = g:kd_lsp_bin . s:kd_path_sep . $PATH
    endif
  endif

  " Prefer the version-controlled LSP-manager wrappers, but allow an explicitly
  " installed server from PATH as a fallback.  MobaXterm may expose .exe files.
  function! s:KDLspExecutable(name) abort
    for l:candidate in [g:kd_lsp_bin . '/' . a:name, g:kd_lsp_bin . '/' . a:name . '.exe']
      if executable(l:candidate)
        return l:candidate
      endif
    endfor
    if executable(a:name)
      let l:path = exepath(a:name)
      return empty(l:path) ? a:name : l:path
    endif
    return ''
  endfunction

  function! s:KDLspHealth() abort
    let l:vim_line = get(split(execute('version'), "\n"), 0, 'Vim version unavailable')
    echomsg 'LSP/completion health: ' . l:vim_line
    echomsg '  yegappan/lsp Vim requirement (>= 9.0, +job, +channel): ' . (s:KDHasSupportedVimForLsp() ? 'OK' : 'NOT MET')
    echomsg '  LSP home: ' . g:kd_lsp_home
    echomsg '  LSP bin:  ' . g:kd_lsp_bin
    if exists('g:plugs') && has_key(g:plugs, 'lsp')
      echomsg '  yegappan/lsp: declared (' . g:plugs['lsp'].dir . ')'
    else
      echomsg '  yegappan/lsp: not declared (requires Vim 9.0+)'
    endif
    let l:servers = ['bash-language-server', 'yaml-language-server', 'ansible-language-server', 'pyright-langserver', 'typescript-language-server', 'vscode-json-language-server', 'vscode-html-language-server', 'vscode-css-language-server', 'vim-language-server', 'terraform-ls', 'helm_ls', 'docker-language-server']
    for l:server in l:servers
      let l:path = s:KDLspExecutable(l:server)
      echomsg printf('  %-28s %s', l:server . ':', empty(l:path) ? 'not installed' : l:path)
    endfor
    echomsg '  Install/check servers with: tools/lsp/lsp-manager-mobaxterm.sh install / check'
  endfunction
  command! KDLspHealth call <SID>KDLspHealth()
  " Preserve the old diagnostic command name as an alias for muscle memory.
  command! KDCompletionHealth call <SID>KDLspHealth()

  function! s:KDModernHealth() abort
    echomsg 'Modern Vim health:'
    echomsg '  fzf: ' . (executable('fzf') ? get(split(system('fzf --version 2>/dev/null'), "\n"), 0, 'available') : 'NOT FOUND (fzf.vim requires >= 0.54)')
    echomsg '  ripgrep: ' . (executable('rg') ? get(split(system('rg --version 2>/dev/null'), "\n"), 0, 'available') : 'NOT FOUND (:Rg unavailable)')
    echomsg '  ctags: ' . (executable('ctags') ? 'available' : 'NOT FOUND (Tagbar disabled)')
    echomsg '  yegappan/lsp: ' . (s:KDHasSupportedVimForLsp() ? 'Vim requirement OK' : 'Vim 9.0+ required')
    echomsg '  managed LSP bin: ' . g:kd_lsp_bin
    echomsg '  terraform: ' . (executable('terraform') ? 'available' : 'not installed')
    echomsg '  helm: ' . (executable('helm') ? 'available' : 'not installed')
    echomsg '  ansible-lint: ' . (executable('ansible-lint') ? 'available' : 'not installed')
    echomsg '  yamllint: ' . (executable('yamllint') ? 'available' : 'not installed')
    echomsg '  shellcheck: ' . (executable('shellcheck') ? 'available' : 'not installed')
    echomsg '  ruff: ' . (executable('ruff') ? 'available' : 'not installed')
    echomsg '  hadolint: ' . (executable('hadolint') ? 'available' : 'not installed')
    echomsg '  tflint: ' . (executable('tflint') ? 'available' : 'not installed')
    echomsg '  stale Syntastic: ' . (exists(':SyntasticCheck') ? 'LOADED - run :PlugClean, quit all Vim instances, then restart' : 'not loaded')
  endfunction
  command! KDModernHealth call <SID>KDModernHealth()

  set nocompatible        " Use Vim defaults rather than vi compatibility
  set background=dark     " Assume a dark terminal background
  set encoding=utf-8
  set fileformats=unix,dos

  " MobaXterm supports a 256-color terminal. Some bundled Vim builds report
  " a lower terminal color count, which breaks legacy 256-color schemes such
  " as grb256 and also changes Lightline's palette.
  if !has('gui_running') && exists('&t_Co') && &t_Co < 256
    set t_Co=256
  endif

  " MobaXterm ships Bash and Unix tools. Use Bash explicitly so :!, system(),
  " vim-plug, Git hooks and helper commands all use the same shell semantics.
  if executable('/bin/bash')
    set shell=/bin/bash
  elseif executable('/bin/sh')
    set shell=/bin/sh
  endif
  set shellcmdflag=-c

  " If a native Win32 Vim binary is ever launched from MobaXterm, keep its
  " path handling Unix-friendly. Cygwin/win32unix Vim builds do not need
  " these Windows-only option changes.
  if has('win32') || has('win64')
    if exists('+shellslash')
      set shellslash
    endif
    set shellquote=
    set shellxquote=\"
    if exists('+completeslash')
      set completeslash=slash
    endif
  endif

  " Always use ~/.vim rather than Vim's native-Windows "vimfiles" convention.
  " This also keeps the same layout when HOME is a MobaXterm persistent home
  " or a Windows folder exposed as /drives/c/....
  let s:kd_vim_runtime = expand('~/.vim')
  let s:kd_vim_after = s:kd_vim_runtime . '/after'
  let s:kd_runtime_paths = split(&runtimepath, ',')

  if index(s:kd_runtime_paths, s:kd_vim_runtime) < 0
    let &runtimepath = s:kd_vim_runtime . ',' . &runtimepath
  endif
  if index(split(&runtimepath, ','), s:kd_vim_after) < 0
    let &runtimepath .= ',' . s:kd_vim_after
  endif

  " Arrow-key fix for MobaXterm/xterm-style terminals.
  if &term[:4] ==# 'xterm' || &term[:5] ==# 'screen' || &term[:3] ==# 'rxvt'
    inoremap <silent> <C-[>OC <Right>
  endif
" }

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" => Vim Options
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" kd options {

  " Prevent automatically changing to open file directory
  "   let g:kd_no_autochdir = 1

  " Disable views
  "   let g:kd_no_views = 1

  " Leader keys
  "   let g:kd_leader='\'
  "   let g:kd_localleader='_'

  " Disable easier moving in tabs and windows
  "   let g:kd_no_easyWindows = 1

  " Disable wrap relative motion for start/end line motions
  "   let g:kd_no_wrapRelMotion = 1

  " Disable fast tab navigation
  "   let g:kd_no_fastTabs = 1

  " Clear search highlighting
  "   let g:kd_clear_search_highlight = 1


  " Disable whitespace stripping
  "   let g:kd_keep_trailing_whitespace = 1

  " vim files directory
  "   let g:kd_consolidated_directory = <full path to desired directory>
  "   eg: let g:kd_consolidated_directory = $HOME . '/.vim/'

  " This makes the completion popup strictly passive.
  " Keypresses acts normally. <ESC> takes you of insert mode, words don't
  " automatically complete, pressing <CR> inserts a newline, etc. Iff the
  " menu is open, tab will cycle through it. If a snippet is selected, <C-k>
  " expands it and jumps between fields.
  "   let g:kd_noninvasive_completion = 1

  " Don't turn conceallevel or concealcursor
  "   let g:kd_no_conceal = 1

  " Leave the default font and size in GVim
  " To set your own font, do it from ~/.vimrc.local
  "   let g:kd_no_big_font = 1

  " Disable  omni complete
  "   let g:kd_no_omni_complete = 1

  " vim-visual-multi configuration can be overridden in ~/.vimrc.before.local.
  " See :help visual-multi and :help vm-mappings.

  " Mappings for editing/applying kd config
  "   let g:kd_edit_config_mapping='<leader>ev'
  "   let g:kd_apply_config_mapping='<leader>sv'
" }

" Use local before if available {
  let s:kd_before_local = expand('~/.vimrc.before.local')
  if filereadable(s:kd_before_local)
    execute 'source ' . fnameescape(s:kd_before_local)
  endif
" }

" AI feature switches: read before plugin declaration and take precedence over
" legacy 'github_copilot' and 'codex' bundle names. Disabled means the plugin,
" integrations and mappings are not loaded, even if old bundle names remain.
if !exists('g:kd_enable_copilot') | let g:kd_enable_copilot = v:false | endif
if !exists('g:kd_enable_codex') | let g:kd_enable_codex = v:false | endif
for s:kd_ai_flag in ['kd_enable_copilot', 'kd_enable_codex']
  let s:kd_ai_value = get(g:, s:kd_ai_flag)
  if type(s:kd_ai_value) != v:t_bool &&
        \ (type(s:kd_ai_value) != v:t_number || index([0, 1], s:kd_ai_value) < 0)
    throw 'AI flag ' . s:kd_ai_flag . ' must be v:true, v:false, 1 or 0'
  endif
endfor
unlet s:kd_ai_flag s:kd_ai_value

" MobaXterm deliberately does not declare an AI plugin because its
" Windows Node/npm bridge is intended for LSP servers, not Copilot or Codex.
" The booleans remain visible in its local template, but enabling AI is not
" supported here; make the limitation explicit instead of failing silently.
if g:kd_enable_copilot || g:kd_enable_codex
  echohl WarningMsg
  echomsg 'MobaXterm: AI plugins are not supported by this Vimrc; the AI flags have no effect.'
  echohl None
endif

" 2.4 migration guard: Syntastic was replaced by ALE.  If an undeclared old
" Syntastic directory is still present on runtimepath (for example in a Vim
" session that sourced this vimrc without restarting), keep it passive so it
" cannot invoke obsolete checkers.  Run :PlugClean and restart Vim to remove it.
let g:syntastic_mode_map = {'mode': 'passive'}
let g:syntastic_check_on_open = 0
let g:syntastic_check_on_wq = 0

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" => vim-plug Bootstrap
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" vim-plug bootstrap {
  if !exists('g:kd_plugin_directory')
    let g:kd_plugin_directory = expand('~/.vim/plugged')
  else
    let g:kd_plugin_directory = expand(g:kd_plugin_directory)
  endif

  " TLS verification is enabled by default.  To force curl without certificate
  " validation, set this to 0 in ~/.vimrc.before.local.
  if !exists('g:kd_curl_tls_verify')
    let g:kd_curl_tls_verify = 1
  endif

  " When verified TLS fails, optionally retry once with --insecure.  Set this
  " to 0 for strict certificate validation with no fallback.
  if !exists('g:kd_curl_allow_insecure_fallback')
    let g:kd_curl_allow_insecure_fallback = 1
  endif

  " Optional custom CA bundle, useful with an internal/corporate CA.
  " On MobaXterm this is the preferred solution for a corporate TLS proxy:
  "   let g:kd_curl_ca_bundle = '/path/to/ca-bundle.pem'
  " If verified TLS still fails and g:kd_curl_allow_insecure_fallback is 1,
  " the bootstrap retries once with curl --insecure and emits a warning.
  let s:kd_plug_file = expand('~/.vim/autoload/plug.vim')
  let s:kd_plug_url = 'https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  let s:kd_plug_bootstrapped = 0

  if !filereadable(s:kd_plug_file)
    echo 'vim-plug not found; bootstrapping it now...'

    let s:kd_plug_autoload_dir = fnamemodify(s:kd_plug_file, ':h')
    if !isdirectory(s:kd_plug_autoload_dir)
      " Vim's mkdir() can fail on some MobaXterm HOME mappings (notably
      " Windows/OneDrive paths exposed below /drives). Try it first, then
      " fall back to MobaXterm's mkdir -p with proper shell quoting.
      try
        call mkdir(s:kd_plug_autoload_dir, 'p')
      catch /^Vim\%((\a\+)\)\=:E739/
        " Handled by the shell fallback below.
      endtry

      if !isdirectory(s:kd_plug_autoload_dir) && executable('mkdir')
        silent execute '!mkdir -p ' . shellescape(s:kd_plug_autoload_dir)
      endif

      if !isdirectory(s:kd_plug_autoload_dir)
        echoerr 'Cannot create vim-plug autoload directory: ' . s:kd_plug_autoload_dir
        finish
      endif
    endif

    if !executable('curl')
      echoerr 'Cannot bootstrap vim-plug: curl is required.'
      finish
    endif

    let s:kd_curl_common = 'curl --fail --location --silent --show-error'
          \ . ' --output ' . shellescape(s:kd_plug_file)
    if g:kd_curl_tls_verify && exists('g:kd_curl_ca_bundle') && !empty(g:kd_curl_ca_bundle)
      let s:kd_ca_bundle = expand(g:kd_curl_ca_bundle)
      if !filereadable(s:kd_ca_bundle)
        echoerr 'Configured curl CA bundle is not readable: ' . s:kd_ca_bundle
        finish
      endif
      let s:kd_curl_common .= ' --cacert ' . shellescape(s:kd_ca_bundle)
    endif

    if g:kd_curl_tls_verify
      " Preferred path: verified TLS.
      silent execute '!' . s:kd_curl_common . ' ' . shellescape(s:kd_plug_url)
      let s:kd_curl_verified_failed = v:shell_error || !filereadable(s:kd_plug_file) || getfsize(s:kd_plug_file) <= 0

      " Optional fallback for environments where the local CA chain cannot be
      " fixed immediately.  The retry is explicit and emits a warning.
      if s:kd_curl_verified_failed && g:kd_curl_allow_insecure_fallback
        call delete(s:kd_plug_file)
        echohl WarningMsg
        echom 'Verified TLS download failed; retrying vim-plug bootstrap with curl --insecure.'
        echohl None
        silent execute '!' . s:kd_curl_common . ' --insecure ' . shellescape(s:kd_plug_url)
      endif
    else
      echohl WarningMsg
      echom 'vim-plug bootstrap is configured to use curl --insecure; TLS certificates will not be validated.'
      echohl None
      silent execute '!' . s:kd_curl_common . ' --insecure ' . shellescape(s:kd_plug_url)
    endif

    if v:shell_error || !filereadable(s:kd_plug_file) || getfsize(s:kd_plug_file) <= 0
      call delete(s:kd_plug_file)
      echoerr 'vim-plug bootstrap failed: ' . s:kd_plug_file . ' was not created.'
      finish
    endif

    let s:kd_plug_bootstrapped = 1
  endif

  if !executable('git')
    echoerr 'vim-plug requires Git to install and update plugins.'
    finish
  endif

  call plug#begin(g:kd_plugin_directory)
" }

" => Plugin bundles (Vim9, vim-plug)
" Every general bundle uses Fern, Stargate, Expand Region and native whitespace
" indication by default. Switch one provider at a time in vimrc.before.local.
"    g:kd_explorer       = 'fern'       or 'nerdtree'
"    g:kd_motion         = 'stargate'   or 'easymotion'
"    g:kd_selection      = 'expand-region' or 'wildfire'
"    g:kd_indent_display = 'native'     or 'vim-indent-guides'
" Invalid selections stop startup with an explanatory error.
" `general` is a prerequisite for all four alternatives and for Lightline.
if !exists('g:kd_explorer') | let g:kd_explorer = 'fern' | endif
if !exists('g:kd_motion') | let g:kd_motion = 'stargate' | endif
if !exists('g:kd_selection') | let g:kd_selection = 'expand-region' | endif
if !exists('g:kd_indent_display') | let g:kd_indent_display = 'native' | endif
for s:kd_pair in [
      \ ['kd_explorer', ['fern', 'nerdtree']],
      \ ['kd_motion', ['stargate', 'easymotion']],
      \ ['kd_selection', ['expand-region', 'wildfire']],
      \ ['kd_indent_display', ['native', 'vim-indent-guides']]
      \ ]
  if index(s:kd_pair[1], get(g:, s:kd_pair[0])) < 0
    throw 'Invalid ' . s:kd_pair[0] . ': ' . string(get(g:, s:kd_pair[0]))
  endif
endfor
unlet s:kd_pair

" Extra bundles can be added in vimrc.before.local, without editing these files.
" No plugin snapshots or commit pins are enabled in this release.
if !exists('g:kd_bundle_groups')
  let g:kd_bundle_groups = ['general', 'lsp', 'ale', 'programming', 'markdown', 'ansible', 'python', 'docker', 'javascript', 'html', 'terraform', 'helm']
endif

" MobaXterm: always remove AI groups, regardless of legacy settings.
call filter(g:kd_bundle_groups, "index(['github_copilot', 'codex'], v:val) < 0")

if !exists('g:override_kd_bundles')
  if index(g:kd_bundle_groups, 'general') >= 0
    if g:kd_explorer ==# 'fern'
      Plug 'lambdalisue/vim-fern'
    else
      Plug 'preservim/nerdtree'
    endif
    Plug 'tpope/vim-surround'
    Plug 'tpope/vim-repeat'
    Plug 'cohama/lexima.vim'
    Plug 'junegunn/fzf'
    Plug 'junegunn/fzf.vim'
    Plug 'mg979/vim-visual-multi', { 'branch': 'master' }
    if g:kd_motion ==# 'stargate'
      Plug 'monkoose/vim9-stargate'
    else
      Plug 'easymotion/vim-easymotion'
    endif
    Plug 'mbbill/undotree'
    if g:kd_indent_display ==# 'vim-indent-guides'
      Plug 'preservim/vim-indent-guides'
    endif
    Plug 'airblade/vim-gitgutter'
