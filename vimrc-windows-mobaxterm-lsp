    " yegappan/lsp {
      if count(g:kd_bundle_groups, 'lsp') && s:KDHasSupportedVimForLsp()
        function! s:KDAddManagedLspServer(servers, name, filetypes, executable, args) abort
          let l:path = s:KDLspExecutable(a:executable)
          if empty(l:path)
            return
          endif
          call add(a:servers, {
                \ 'name': a:name,
                \ 'filetype': a:filetypes,
                \ 'path': l:path,
                \ 'args': a:args,
                \ })
        endfunction

        function! s:KDFilterAnsibleDiagnostics(diags) abort
          " Ansible playbooks often contain long module arguments, URLs, Jinja
          " expressions and deliberately aligned comments. These are style-only
          " concerns for this profile. Suppress line-length, comments-indentation,
          " and truthy diagnostics if an LSP backend emits them.
          let l:filtered = []
          for l:diag in a:diags
            let l:msg = get(l:diag, 'message', '')
            let l:code = string(get(l:diag, 'code', ''))
            if l:code =~? 'line[-_]length'
                  \ || l:code =~? 'comments[-_]indentation'
                  \ || l:code =~? '\ctruthy\c'
                  \ || l:msg =~? '\cline[- ]length\c'
                  \ || l:msg =~? '\cline too long\c'
                  \ || l:msg =~? '\ctoo long.*[0-9].*>.*[0-9]'
                  \ || l:msg =~? '\ccomment not indented like content\c'
                  \ || l:msg =~? '\ccomments[- ]indentation\c'
                  \ || l:msg =~? '\ctruthy value should be one of\c'
                  \ || l:msg =~? '\ctruthy\c'
              continue
            endif
            call add(l:filtered, l:diag)
          endfor
          return l:filtered
        endfunction

        function! s:KDSetupLsp() abort
          " yegappan/lsp owns interactive LSP completion and diagnostics.
          " ALE remains intentionally limited to external linters/fixers.
          call LspOptionsSet({
                \ 'autoComplete': v:true,
                \ 'autoHighlightDiags': v:true,
                \ 'showDiagInPopup': v:false,
                \ 'showDiagOnStatusLine': v:true,
                \ 'showDiagWithVirtualText': v:false,
                \ })

          let l:servers = []
          call s:KDAddManagedLspServer(l:servers, 'bashls', 'sh', 'bash-language-server', ['start'])
          call s:KDAddManagedLspServer(l:servers, 'yamlls', ['yaml', 'dockercompose'], 'yaml-language-server', ['--stdio'])

          " ALE is the single Ansible lint owner.  Keep ansible-language-server
          " validation/completion/navigation enabled, but turn off its ansible-lint
          " integration to avoid duplicate diagnostics with ALE.
          let l:ansible_path = s:KDLspExecutable('ansible-language-server')
          if !empty(l:ansible_path)
            call add(l:servers, {
                  \ 'name': 'ansiblels',
                  \ 'filetype': 'yaml.ansible',
                  \ 'path': l:ansible_path,
                  \ 'args': ['--stdio'],
                  \ 'processDiagHandler': function('<SID>KDFilterAnsibleDiagnostics'),
                  \ 'workspaceConfig': {
                  \   'ansible': {
                  \     'validation': {
                  \       'enabled': v:true,
                  \       'lint': {'enabled': v:false},
                  \     },
                  \   },
                  \ },
                  \ })
          endif
          call s:KDAddManagedLspServer(l:servers, 'pyright', 'python', 'pyright-langserver', ['--stdio'])
          call s:KDAddManagedLspServer(l:servers, 'tsserver', ['javascript', 'javascriptreact', 'typescript', 'typescriptreact'], 'typescript-language-server', ['--stdio'])
          call s:KDAddManagedLspServer(l:servers, 'jsonls', 'json', 'vscode-json-language-server', ['--stdio'])
          call s:KDAddManagedLspServer(l:servers, 'htmlls', 'html', 'vscode-html-language-server', ['--stdio'])
          call s:KDAddManagedLspServer(l:servers, 'cssls', ['css', 'scss', 'less'], 'vscode-css-language-server', ['--stdio'])
          call s:KDAddManagedLspServer(l:servers, 'vimls', 'vim', 'vim-language-server', ['--stdio'])
          call s:KDAddManagedLspServer(l:servers, 'terraformls', 'terraform', 'terraform-ls', ['serve'])
          call s:KDAddManagedLspServer(l:servers, 'helmls', 'helm', 'helm_ls', ['serve'])
          call s:KDAddManagedLspServer(l:servers, 'dockerls', ['dockerfile', 'dockercompose'], 'docker-language-server', ['start', '--stdio'])

          if !empty(l:servers)
            call LspAddServer(l:servers)
          endif
        endfunction

        function! s:KDOnLspAttached() abort
          setlocal signcolumn=yes
          nnoremap <buffer> <silent> gd <Cmd>LspGotoDefinition<CR>
          nnoremap <buffer> <silent> gr <Cmd>LspShowReferences<CR>
          nnoremap <buffer> <silent> gi <Cmd>LspGotoImpl<CR>
          nnoremap <buffer> <silent> gt <Cmd>LspGotoTypeDef<CR>
          nnoremap <buffer> <silent> K <Cmd>LspHover<CR>
          nnoremap <buffer> <silent> <leader>rn <Cmd>LspRename<CR>
          nnoremap <buffer> <silent> [g <Cmd>LspDiag prev<CR>
          nnoremap <buffer> <silent> ]g <Cmd>LspDiag next<CR>
          nnoremap <buffer> <silent> <leader>ca <Cmd>LspCodeAction<CR>
          nnoremap <buffer> <silent> <leader>lf <Cmd>LspFormat<CR>
        endfunction

        augroup kd_lsp
          autocmd!
          autocmd User LspSetup call <SID>KDSetupLsp()
          autocmd User LspAttached call <SID>KDOnLspAttached()
        augroup END

        " docker-language-server should start only for Dockerfile/Compose buffers.
        augroup kd_dockercompose_ft
          autocmd!
          autocmd BufRead,BufNewFile docker-compose.yml,docker-compose.yaml,compose.yml,compose.yaml setfiletype dockercompose
          autocmd FileType dockercompose setlocal syntax=yaml
        augroup END

        " Keep popup navigation predictable. Copilot deliberately does not own <Tab>.
        call s:KDMapCompletionTabs()
        inoremap <expr> <CR> pumvisible() ? "\<C-y>" : "\<CR>"
      endif
    " }

    " ALE {
      if count(g:kd_bundle_groups, 'ale')
        " yegappan/lsp owns LSP; ALE is dedicated to asynchronous external linters/fixers.
        let g:ale_disable_lsp = 1
        let g:ale_linters_explicit = 1
        let g:ale_lint_on_text_changed = 'never'
        let g:ale_lint_on_insert_leave = 1
        let g:ale_lint_on_save = 1
        let g:ale_lint_on_enter = 1
        " Diagnostics are text-only at the bottom of Vim. ALE virtual text is
        " deliberately disabled so messages such as '# E: line too long ...'
        " are never rendered beside the source line.
        let g:ale_echo_cursor = 1
        let g:ale_echo_msg_format = '[%linter%] %severity%: %s'
        let g:ale_virtualtext_cursor = 'disabled'
        let g:ale_cursor_detail = 0
        let g:ale_open_list = 0
        let g:ale_set_loclist = 1
        let g:ale_yaml_yamllint_options = "-d '{extends: default, rules: {line-length: disable, comments-indentation: disable, truthy: disable}}'"
        let g:ale_sign_error = '✗'
        let g:ale_sign_warning = '⚠'

        " Use the same package-controlled yamllint policy for BOTH normal YAML and
        " Ansible YAML. Previous releases applied this only to yaml.ansible, which
        " allowed plain 'yaml' buffers to fall back to ALE's stock yamllint and
        " reintroduce line-length/comments-indentation/truthy style warnings.
        " Disable the rules at source, then filter them again as a defensive guard.
        function! s:KDHandleYamlLint(buffer, lines) abort
          let l:items = ale#handlers#yamllint#Handle(a:buffer, a:lines)
          call filter(l:items,
                \ "index(['line-length', 'comments-indentation', 'truthy'], get(v:val, 'code', '')) < 0")
          return l:items
        endfunction

        if isdirectory(g:kd_plugin_directory . '/ale')
          let s:kd_yamllint_command = "%e -d '{extends: default, rules: {line-length: disable, comments-indentation: disable, truthy: disable}}' -f parsable %t"
          call ale#linter#Define('yaml', {
                \ 'name': 'yamllint_kd',
                \ 'executable': 'yamllint',
                \ 'command': s:kd_yamllint_command,
                \ 'callback': function('<SID>KDHandleYamlLint'),
                \ })
          call ale#linter#Define('ansible', {
                \ 'name': 'yamllint_kd',
                \ 'executable': 'yamllint',
                \ 'command': s:kd_yamllint_command,
                \ 'callback': function('<SID>KDHandleYamlLint'),
                \ })
        endif
        let g:ale_linters = {
          \ 'ansible': ['yamllint_kd', 'ansible_lint'],
          \ 'yaml': ['yamllint_kd'],
          \ 'python': ['ruff'],
          \ 'sh': ['shellcheck'],
          \ 'dockerfile': ['hadolint'],
          \ 'terraform': ['terraform', 'tflint'],
          \ }

        " Critical for compound filetype yaml.ansible: ALE handles the yaml and
        " ansible components separately. Buffer-local settings take precedence
        " and make the selection unambiguous for both components.
        function! s:KDConfigureAnsibleAleBuffer() abort
          let b:ale_linter_aliases = ['ansible']
          let b:ale_linters = ['yamllint_kd', 'ansible_lint']
        endfunction
        augroup kd_ale_ansible_buffers
          autocmd!
          autocmd FileType yaml.ansible call <SID>KDConfigureAnsibleAleBuffer()
        augroup END

        let g:ale_fixers = {
          \ '*': ['remove_trailing_lines', 'trim_whitespace'],
          \ 'python': ['ruff_format'],
          \ 'terraform': ['terraform'],
