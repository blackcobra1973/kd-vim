        nnoremap <silent> <leader>al :ALELint<CR>
        nnoremap <silent> <leader>af :ALEFix<CR>
        nnoremap <silent> <leader>an :ALENextWrap<CR>
        nnoremap <silent> <leader>ap :ALEPreviousWrap<CR>
      endif
