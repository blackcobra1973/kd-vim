          Plug 'Shougo/ddc-filter-sorter_rank'
        endif
      elseif count(g:kd_bundle_groups, 'neocomplete')
        " Legacy compatibility only. Prefer the 'ddc' group for new systems.
        Plug 'Shougo/neocomplete.vim'
      endif
    " }

    " PHP {
      if count(g:kd_bundle_groups, 'php')
        Plug 'spf13/PIV'
        Plug 'arnaud-lb/vim-php-namespace'
        Plug 'beyondwords/vim-twig'
      endif
    " }

    " Python {
      if count(g:kd_bundle_groups, 'python')
        " Pick either python-mode or pyflakes & pydoc
        Plug 'python-mode/python-mode', { 'for': 'python', 'branch': 'develop' }
        Plug 'yssource/python.vim'
        Plug 'vim-scripts/python_match.vim'
