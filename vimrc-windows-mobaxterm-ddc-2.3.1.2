            let g:indent_guides_enable_on_vim_startup = 0
            let g:indent_guides_auto_colors = 0

            autocmd VimEnter,Colorscheme * :highlight IndentGuidesOdd  ctermbg=black
            "autocmd VimEnter,Colorscheme * :highlight IndentGuidesOdd  ctermbg=lightgrey
            autocmd VimEnter,Colorscheme * :highlight IndentGuidesEven ctermbg=darkgrey
