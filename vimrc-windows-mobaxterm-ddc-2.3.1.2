        Plug 'Shougo/neosnippet-snippets'
      endif

      if count(g:kd_bundle_groups, 'snipmate')
        Plug 'garbas/vim-snipmate'
        " Source support_function.vim to support vim-snippets.
        if filereadable(g:kd_plugin_directory . '/vim-snippets/snippets/support_functions.vim')
          execute 'source ' . fnameescape(g:kd_plugin_directory . '/vim-snippets/snippets/support_functions.vim')
        endif
      elseif count(g:kd_bundle_groups, 'youcompleteme')
        Plug 'ycm-core/YouCompleteMe'
        Plug 'SirVer/ultisnips'
      elseif count(g:kd_bundle_groups, 'ddc')
        " Current ddc/denops releases require Vim 9.1.1646+ and Deno 2.3+.
        " Only add the denops stack when the local Vim can actually load it.
        if has('patch-9.1.1646') && has('job') && has('channel') && s:KDHasSupportedDeno()
          Plug 'vim-denops/denops.vim'
          Plug 'Shougo/ddc.vim'
          Plug 'Shougo/ddc-ui-native'
          Plug 'Shougo/ddc-source-around'
          Plug 'Shougo/ddc-source-omni'
