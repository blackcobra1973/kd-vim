    " }

    " HTML {
      if count(g:kd_bundle_groups, 'html')
        Plug 'vim-scripts/HTML-AutoCloseTag'
        Plug 'hail2u/vim-css3-syntax'
        Plug 'gorodinskiy/vim-coloresque'
